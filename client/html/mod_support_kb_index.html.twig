{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'kb' %}

{% block meta_title %}{{ 'Knowledge Base Categories'|trans }}{% endblock %}
{% block meta_description %}{{ 'Browse help articles, tutorials, and answers to common questions in our knowledge base.'|trans }}{% endblock %}

{% block body_class %}kb-index{% endblock %}
{% block breadcrumb %}
    {% if request.q %}
        <li class="breadcrumb-item">
            <a class="hover:text-strata-strong transition-colors" href="{{ 'support/kb'|url }}">{{ 'Knowledge Base'|trans }}</a>
        </li>
        <li class="active breadcrumb-item text-strata-strong font-medium truncate max-w-xs" aria-current="page">{{ request.q }}</li>
    {% else %}
        <li class="active breadcrumb-item text-strata-strong font-medium" aria-current="page">{{ 'Knowledge Base'|trans }}</li>
    {% endif %}
{% endblock %}

{% block content %}
{% if request.q %}
    {% set kbcategories = guest.support_kb_category_get_list({ "q": request.q }) %}
    {% set kbarticles = guest.support_kb_article_get_list({ "search": request.q, "per_page": 10 }) %}
{% else %}
    {% set kbcategories = guest.support_kb_category_get_list %}
    {% set kbarticles = null %}
{% endif %}

<div class="flex flex-col gap-8" data-animate="fade-up">
    {# Knowledge Base Hero & Search #}
    <div class="rounded-2xl bg-strata-base border border-strata-hairline p-6 sm:p-10 shadow-xs text-center relative overflow-hidden">
        <div class="relative z-10 max-w-2xl mx-auto flex flex-col items-center">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-strata-brand/10 text-strata-brand text-xs font-semibold mb-3">
                <svg class="size-3.5" aria-hidden="true"><use href="#book" /></svg>
                <span>{{ 'Help & Documentation'|trans }}</span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-strata-strong">{{ 'Knowledge Base'|trans }}</h1>
            <p class="text-sm sm:text-base text-strata-subtle mt-2 mb-6 max-w-lg">{{ 'Browse help articles, guides, and answers to common questions.'|trans }}</p>

            <form method="get" action="" class="w-full max-w-md">
                <div class="relative flex items-center">
                    <span class="absolute left-3.5 flex items-center pointer-events-none text-strata-subtle">
                        <svg class="size-4" aria-hidden="true"><use href="#search" /></svg>
                    </span>
                    <input class="strata-input pl-10 pr-24 py-2.5 text-sm"
                           name="q"
                           type="text"
                           value="{{ request.q }}"
                           placeholder="{{ 'What are you looking for?'|trans }}"
                           aria-label="{{ 'Search articles'|trans }}">
                    <button class="strata-btn strata-btn-primary strata-btn-sm absolute right-1.5" type="submit">
                        <span>{{ 'Search'|trans }}</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Search Results for Articles #}
    {% if kbarticles and kbarticles.list %}
        <div class="strata-card">
            <div class="strata-card-header">
                <h2 class="text-base font-semibold text-strata-strong flex items-center gap-2">
                    <svg class="size-4 text-strata-brand" aria-hidden="true"><use href="#file-text" /></svg>
                    <span>{{ 'Matching articles'|trans }}</span>
                </h2>
                <span class="strata-badge strata-badge-neutral strata-tabular">{{ kbarticles.list|length }}</span>
            </div>
            <div class="divide-y divide-strata-hairline">
                {% for article in kbarticles.list %}
                    <a class="flex items-center justify-between p-4 hover:bg-strata-tint transition-colors group"
                       href='{{ "support/kb/#{article.category.slug}/#{article.slug}"|url }}'>
                        <div class="flex items-center gap-3 min-w-0">
                            <svg class="size-4 text-strata-subtle group-hover:text-strata-brand shrink-0 transition-colors" aria-hidden="true"><use href="#file-text" /></svg>
                            <span class="font-medium text-sm text-strata-strong group-hover:text-strata-brand transition-colors truncate">{{ article.title }}</span>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <span class="text-xs text-strata-subtle hidden sm:inline">{{ article.category.title }}</span>
                            <svg class="size-4 text-strata-subtle group-hover:text-strata-strong transition-colors" aria-hidden="true"><use href="#chevron-right" /></svg>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# Categories Bento Grid #}
    <div>
        {% if kbarticles and kbarticles.list %}
            <h2 class="text-lg font-semibold text-strata-strong mb-4">{{ 'Matching categories'|trans }}</h2>
        {% endif %}

        {% if kbcategories.list %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" data-stagger>
                {% for category in kbcategories.list %}
                    <div data-stagger-item
                         class="rounded-xl bg-strata-base border border-strata-hairline hover:border-strata-line hover:shadow-md transition-all p-5 flex flex-col justify-between group">
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-3">
                                <div class="size-9 rounded-lg bg-strata-brand/10 text-strata-brand flex items-center justify-center shrink-0">
                                    <svg class="size-5" aria-hidden="true"><use href="#book" /></svg>
                                </div>
                                <span class="strata-badge strata-badge-neutral strata-tabular text-xs">
                                    {{ category.articles|length }} {{ 'articles'|trans }}
                                </span>
                            </div>

                            <h3 class="text-base font-semibold text-strata-strong group-hover:text-strata-brand transition-colors">
                                <a href='{{ "support/kb/#{category.slug}"|url }}'>{{ category.title }}</a>
                            </h3>

                            {% if category.description %}
                                <p class="text-xs text-strata-subtle mt-1.5 mb-4 line-clamp-2">{{ category.description }}</p>
                            {% else %}
                                <div class="mb-4"></div>
                            {% endif %}

                            {% if category.articles %}
                                <ul class="flex flex-col gap-1 border-t border-strata-hairline pt-3 list-none m-0 p-0">
                                    {% for article in category.articles|slice(0, 3) %}
                                        <li>
                                            <a class="flex items-center gap-2 text-xs text-strata-default hover:text-strata-brand transition-colors py-1 group/art"
                                               href='{{ "support/kb/#{article.category.slug}/#{article.slug}"|url }}'>
                                                <svg class="size-3 text-strata-subtle group-hover/art:text-strata-brand shrink-0 transition-colors" aria-hidden="true"><use href="#file-text" /></svg>
                                                <span class="truncate">{{ article.title }}</span>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>

                        <div class="mt-4 pt-3 border-t border-strata-hairline">
                            <a href='{{ "support/kb/#{category.slug}"|url }}'
                               class="inline-flex items-center gap-1.5 text-xs font-semibold text-strata-brand hover:text-strata-brand-hover transition-colors">
                                <span>{{ 'View all articles'|trans }}</span>
                                <svg class="size-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><use href="#arrow-right" /></svg>
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="strata-card p-8 sm:p-12 text-center">
                {% if request.q %}
                    <div class="inline-flex items-center justify-center size-12 rounded-xl bg-strata-warning-tint text-strata-warning mb-3">
                        <svg class="size-6" aria-hidden="true"><use href="#search" /></svg>
                    </div>
                    <h2 class="text-lg font-semibold text-strata-strong mb-1">{{ 'No results found'|trans }}</h2>
                    <p class="text-sm text-strata-subtle mb-6 max-w-md mx-auto">
                        {{ 'No articles or categories matched your search for:'|trans }} <strong class="text-strata-strong">{{ request.q }}</strong>
                    </p>
                    <div class="flex flex-wrap items-center justify-center gap-3">
                        <a class="strata-btn strata-btn-primary" href="{{ 'support/contact-us'|url }}">
                            <svg class="size-4" aria-hidden="true"><use href="#lifebuoy" /></svg>
                            <span>{{ 'Contact support'|trans }}</span>
                        </a>
                        <a class="strata-btn strata-btn-secondary" href="{{ 'support/kb'|url }}">
                            <span>{{ 'Browse all articles'|trans }}</span>
                        </a>
                    </div>
                {% else %}
                    <div class="inline-flex items-center justify-center size-12 rounded-xl bg-strata-fill text-strata-subtle mb-3">
                        <svg class="size-6" aria-hidden="true"><use href="#book" /></svg>
                    </div>
                    <h2 class="text-base font-semibold text-strata-strong mb-1">{{ 'No Knowledge Base Categories'|trans }}</h2>
                    <p class="text-sm text-strata-subtle">{{ 'No knowledge base categories are available yet.'|trans }}</p>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
