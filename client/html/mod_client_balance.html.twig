{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'payments' %}

{% block meta_title %}{{ 'Wallet'|trans }}{% endblock %}
{% block breadcrumb %}
    <li class="active breadcrumb-item text-strata-strong font-medium" aria-current="page">{{ 'Wallet'|trans }}</li>
{% endblock %}

{% set profile = client.profile_get %}

{% block body_class %}client-balance{% endblock %}
{% block content %}
<div class="flex flex-col gap-6" data-animate="fade-up">
    {# Balance Hero Card #}
    <div class="rounded-2xl bg-strata-base border border-strata-hairline p-6 sm:p-8 shadow-xs">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-center">
            <div>
                <div class="flex items-center gap-2 text-strata-subtle text-xs font-semibold uppercase tracking-wider mb-1">
                    <svg class="size-4 text-strata-brand" aria-hidden="true"><use href="#wallet" /></svg>
                    <span>{{ 'Available Balance'|trans }}</span>
                </div>
                <div class="text-3xl sm:text-4xl font-bold tracking-tight text-strata-strong strata-tabular"
                     data-count-to="{{ profile.balance|default(0) }}"
                     data-count-decimals="2">
                    {{ profile.balance|format_currency(profile.currency ?? default_currency) }}
                </div>
                <p class="text-xs sm:text-sm text-strata-subtle mt-2">
                    {{ 'Your balance is used automatically to pay future invoices and recurring services.'|trans }}
                </p>
            </div>

            {% if guest.invoice_funds_enabled %}
                <div class="p-4 sm:p-5 rounded-xl bg-strata-recessed border border-strata-hairline flex flex-col gap-3">
                    <span class="text-xs font-semibold text-strata-strong uppercase tracking-wider">{{ 'Add Funds to Balance'|trans }}</span>
                    <form method="post"
                          class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2"
                          action="{{ 'invoice/funds_invoice'|api_url }}"
                          {{ fb_api_form({callback: 'onAfterInvoiceCreated'}) }}>
                        <div class="relative flex-1">
                            <span class="absolute inset-y-0 left-3 flex items-center text-xs font-semibold text-strata-subtle pointer-events-none">
                                {{ profile.currency|default(default_currency) }}
                            </span>
                            <input id="appendedPrependedInput"
                                   class="strata-input pl-12 strata-tabular text-sm"
                                   type="number"
                                   step="any"
                                   min="1"
                                   name="amount"
                                   placeholder="0.00"
                                   required="required"
                                   aria-label="{{ 'Deposit Amount'|trans }}">
                        </div>
                        <button class="strata-btn strata-btn-primary shrink-0" type="submit">
                            <svg class="size-4" aria-hidden="true"><use href="#plus" /></svg>
                            <span>{{ 'Add Funds'|trans }}</span>
                        </button>
                    </form>
                    <span class="text-[11px] text-strata-subtle">
                        {{ 'An invoice will be generated immediately for the specified amount.'|trans }}
                    </span>
                </div>
            {% endif %}
        </div>
    </div>

    {# Transactions Ledger #}
    <div class="strata-card">
        <div class="strata-card-header flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
            <div>
                <h2 class="text-base font-semibold text-strata-strong flex items-center gap-2">
                    <svg class="size-4 text-strata-brand" aria-hidden="true"><use href="#receipt" /></svg>
                    <span>{{ 'Transaction History'|trans }}</span>
                </h2>
                <p class="text-xs text-strata-subtle mt-0.5">{{ 'Recent balance deposits, charges, and credits.'|trans }}</p>
            </div>
        </div>

        <div class="p-0">
            {% set transactions = client.client_balance_get_list({ "per_page": 10, "page": request.page }) %}
            <div class="overflow-x-auto">
                <table class="strata-table" data-stagger>
                    <thead>
                        <tr>
                            <th scope="col">{{ 'Description'|trans }}</th>
                            <th scope="col" class="w-44">{{ 'Date'|trans }}</th>
                            <th scope="col" class="w-36 text-right">{{ 'Amount'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for i, tx in transactions.list %}
                            {% set is_positive = (tx.amount ?? 0) >= 0 %}
                            <tr data-stagger-item class="hover:bg-strata-tint transition-colors">
                                <td>
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div class="size-7 rounded-lg {% if is_positive %}bg-strata-success-tint text-strata-success{% else %}bg-strata-danger-tint text-strata-danger{% endif %} flex items-center justify-center shrink-0">
                                            <svg class="size-3.5" aria-hidden="true">
                                                <use href="{% if is_positive %}#arrow-down{% else %}#arrow-up{% endif %}" />
                                            </svg>
                                        </div>
                                        <span class="font-medium text-sm text-strata-strong truncate">{{ tx.description }}</span>
                                    </div>
                                </td>
                                <td class="strata-tabular text-sm text-strata-subtle whitespace-nowrap">{{ tx.created_at|format_date }}</td>
                                <td class="strata-tabular font-semibold text-right text-sm whitespace-nowrap {% if is_positive %}text-strata-success{% else %}text-strata-danger{% endif %}">
                                    {{ is_positive ? '+' : '' }}{{ (tx.amount ?? 0)|format_currency(tx.currency ?? default_currency) }}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="py-12 px-4 text-center text-sm text-strata-subtle">
                                    <div class="inline-flex items-center justify-center size-10 rounded-xl bg-strata-fill text-strata-subtle mb-2">
                                        <svg class="size-5" aria-hidden="true"><use href="#receipt" /></svg>
                                    </div>
                                    <p class="font-medium text-strata-default">{{ 'The list is empty'|trans }}</p>
                                    <p class="text-xs text-strata-subtle mt-0.5">{{ 'You have no recorded wallet transactions.'|trans }}</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr class="bg-strata-tint/60 border-t border-strata-line">
                            <td colspan="2" class="font-semibold text-strata-strong text-sm">{{ 'Total Balance'|trans }}</td>
                            <td class="strata-tabular font-bold text-right text-base text-strata-strong whitespace-nowrap">
                                {{ profile.balance|format_currency(profile.currency ?? default_currency) }}
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            {% if transactions.pages > 1 %}
                <div class="p-4 border-t border-strata-hairline">
                    {{ include('partial_pagination.html.twig', { 'list': transactions, 'url': 'client/balance' }) }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block js %}
<script>
    function onAfterInvoiceCreated(hash) {
        window.location = '{{ "invoice"|url }}/' + hash;
    }
</script>
{% endblock %}
