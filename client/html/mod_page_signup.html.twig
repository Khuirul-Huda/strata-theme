{% extends "layout_public.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'Register'|trans }}{% endblock %}
{% block meta_description %}{{ 'Create an account to order services, manage billing, and track support requests online.'|trans }}{% endblock %}

{% block body_class %}page-signup{% endblock %}

{% block body %}
<div class="w-full max-w-lg mx-auto" data-animate="fade-up">
    {% if settings.login_page_show_logo ?? '1' %}
        <div class="flex justify-center mb-6">
            {{ include('partial_company_logo.html.twig', {
                company: company,
                logo_url: public_logo_url,
                dark_logo_url: public_dark_logo_url,
                link_url: settings.login_page_logo_url|default('/'),
                link_target: '_blank',
                link_rel: 'noopener noreferrer',
                image_class: 'max-h-12 w-auto object-contain',
                image_height: '48px',
                fallback_class: 'text-xl font-bold tracking-tight text-strata-strong'
            }) }}
        </div>
    {% endif %}

    <div class="relative bg-strata-base border border-strata-hairline rounded-2xl shadow-sm p-6 sm:p-8 overflow-hidden">
        {# Subtle top highlight #}
        <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-strata-line to-transparent" aria-hidden="true"></div>

        <div class="flex flex-col items-center text-center mb-6">
            <div class="size-11 rounded-xl bg-strata-brand/10 text-strata-brand flex items-center justify-center mb-3 shadow-xs">
                <svg class="size-5" aria-hidden="true"><use href="#user" /></svg>
            </div>
            <h1 class="text-xl font-semibold text-strata-strong tracking-tight">{{ 'Create a new account'|trans }}</h1>
            <p class="text-xs text-strata-subtle mt-1">{{ 'Fill in your details to register with us'|trans }}</p>
        </div>

        <form method="post" action="{{ 'client/create'|api_url(role: 'guest') }}" class="auth space-y-4" {{ fb_api_form({redirect: '/'|url}) }}>
            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
            {% set r = guest.client_required %}

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="strata-label" for="first-name">{{ 'First Name'|trans }}</label>
                    <input class="strata-input" id="first-name" type="text" name="first_name" value="{{ request.first_name }}" required="required"/>
                </div>

                <div>
                    <label class="strata-label" for="last_name">{{ 'Last Name'|trans }}</label>
                    <input class="strata-input" id="last_name" type="text" name="last_name" value="{{ request.last_name }}"{% if 'last_name' in r %} required="required"{% endif %}/>
                </div>
            </div>

            <div>
                <label class="strata-label" for="reg-email">{{ 'Email Address'|trans }}</label>
                <div class="relative">
                    <input class="strata-input pl-10" id="reg-email" type="email" name="email" value="{{ request.email }}" required="required"/>
                    <div class="pointer-events-none absolute inset-y-0 left-0 pl-3 flex items-center text-strata-subtle">
                        <svg class="size-4" aria-hidden="true"><use href="#mail" /></svg>
                    </div>
                </div>
            </div>

            {% if 'company' in r %}
                <div>
                    <label class="strata-label" for="company">{{ 'Company'|trans }}</label>
                    <input class="strata-input" id="company" type="text" name="company" value="{{ request.company }}" required="required"/>
                </div>
            {% endif %}

            {% if 'birthday' in r %}
                <div>
                    <label class="strata-label" for="birthday">{{ 'Birthday'|trans }}</label>
                    <input class="strata-input" id="birthday" type="date" name="birthday" value=""/>
                </div>
            {% endif %}

            {% if 'gender' in r %}
                <div>
                    <label class="strata-label" for="gender">{{ 'Gender'|trans }}</label>
                    <select class="strata-select" id="gender" name="gender">
                        <option value="male">{{ 'Male'|trans }}</option>
                        <option value="female">{{ 'Female'|trans }}</option>
                        <option value="nonbinary">{{ 'Non-binary'|trans }}</option>
                        <option value="other">{{ 'Other'|trans }}</option>
                    </select>
                </div>
            {% endif %}

            {% if 'address_1' in r %}
                <div>
                    <label class="strata-label" for="address_1">{{ 'Address'|trans }}</label>
                    <input class="strata-input" id="address_1" type="text" name="address_1" value="{{ request.address_1 }}"/>
                </div>
            {% endif %}

            {% if 'address_2' in r %}
                <div>
                    <label class="strata-label" for="address_2">{{ 'Address 2'|trans }}</label>
                    <input class="strata-input" id="address_2" type="text" name="address_2" value="{{ request.address_2 }}"/>
                </div>
            {% endif %}

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {% if 'city' in r %}
                    <div>
                        <label class="strata-label" for="city">{{ 'City'|trans }}</label>
                        <input class="strata-input" id="city" type="text" name="city" value="{{ request.city }}"/>
                    </div>
                {% endif %}

                {% if 'country' in r %}
                    {% set selected_country = request.country|default(guest.system_default_country) %}
                    <div>
                        <label class="strata-label" for="country">{{ 'Country'|trans }}</label>
                        <select class="strata-select" id="country" name="country" required="required">
                            <option value="">{{ '-- Select Country --'|trans }}</option>
                            {% for val,label in guest.system_countries %}
                                <option value="{{ val }}" label="{{ label|e }}" {% if selected_country == val %}selected{% endif %}>{{ label|e }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {% if 'state' in r %}
                    <div>
                        <label class="strata-label" for="state">{{ 'State'|trans }}</label>
                        <input class="strata-input" id="state" type="text" name="state" value="{{ request.state }}"/>
                    </div>
                {% endif %}

                {% if 'postcode' in r %}
                    <div>
                        <label class="strata-label" for="postcode">{{ 'Zip/Postal Code'|trans }}</label>
                        <input class="strata-input" id="postcode" type="text" name="postcode" value="{{ request.postcode }}"/>
                    </div>
                {% endif %}
            </div>

            {% if 'phone' in r %}
                <div>
                    <label class="strata-label" for="phone">{{ 'Phone Number'|trans }}</label>
                    <input type="hidden" id="phone_cc" name="phone_cc" value="{{ request.phone_cc }}">
                    <input class="strata-input js-phone-input" id="phone" type="tel" name="phone" value="{{ request.phone }}" autocomplete="tel" data-initial-country="{{ request.country|default(guest.system_default_country)|lower }}" required="required"/>
                </div>
            {% endif %}

            <div>
                <label class="strata-label" for="reg-timezone">{{ 'Timezone'|trans }}</label>
                <select class="strata-select" id="reg-timezone" name="timezone" data-timezone-select>
                    <option value="">{{ '-- Use system default --'|trans }}</option>
                    {% for region, identifiers in guest.system_timezones %}
                        <optgroup label="{{ region }}">
                            {% for identifier in identifiers %}
                                <option value="{{ identifier }}" {% if request.timezone|default('') == identifier %}selected="selected"{% endif %}>{{ identifier }}</option>
                            {% endfor %}
                        </optgroup>
                    {% endfor %}
                </select>
                <p class="mt-1 text-xs text-strata-subtle">{{ 'Pre-selected from your browser. Used to display dates and times in your local time.'|trans }}</p>
            </div>

            {% set custom_fields = guest.client_custom_fields %}
            {% for field_name, field in custom_fields %}
                {% if field.active|default(false) %}
                    <div>
                        <label class="strata-label" for="{{ field_name }}">{{ field.title|default(field_name|capitalize) }}</label>
                        <input class="strata-input" id="{{ field_name }}" type="text" name="{{ field_name }}" value="{{ request.(field_name)|default('') }}" {% if field.required|default(false) %}required="required"{% endif %} />
                    </div>
                {% endif %}
            {% endfor %}

            {% set honeypot = antispam_honeypot() %}
            {% if honeypot.enabled %}
                {% set honeypot_field = honeypot.field %}
                <div class="sr-only" aria-hidden="true" style="position: absolute; left: -9999px;">
                    <label for="{{ honeypot_field }}">{{ honeypot_field }}</label>
                    <input id="{{ honeypot_field }}" type="text" name="{{ honeypot_field }}" value="" tabindex="-1" autocomplete="off"/>
                </div>
            {% endif %}

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="strata-label" for="reg-password">{{ 'Password'|trans }}</label>
                    <input class="strata-input" id="reg-password" type="password" name="password" value="" required="required"/>
                </div>

                <div>
                    <label class="strata-label" for="password-confirm">{{ 'Password Confirm'|trans }}</label>
                    <input class="strata-input" id="password-confirm" type="password" name="password_confirm" value="" required="required"/>
                </div>
            </div>

            {{ mf.recaptcha }}

            {% if settings.signup_tos|default('0') == 'explicit' %}
                <div class="flex items-start gap-2.5">
                    <input class="mt-0.5 rounded border-strata-line bg-strata-control text-strata-brand focus:ring-strata-focus" type="checkbox" value="" id="flexCheckDefault" required>
                    <label class="text-xs text-strata-subtle leading-relaxed" for="flexCheckDefault">
                        {# TODO: Make this translatable once support for placeholders is implemented #}
                        <span>I agree to the <a class="text-strata-brand hover:underline font-medium" href="{{ 'tos'|url }}" target="_blank">{{ 'Terms of Service'|trans }}</a> and <a class="text-strata-brand hover:underline font-medium" href="{{ 'privacy-policy'|url }}" target="_blank">{{ 'Privacy Policy'|trans }}</a>.</span>
                    </label>
                </div>
            {% endif %}

            <button class="strata-btn strata-btn-primary w-full py-2.5 text-sm font-medium shadow-xs" type="submit">
                <span>{{ 'Register'|trans }}</span>
                <svg class="size-4" aria-hidden="true"><use href="#arrow-right" /></svg>
            </button>

            {% if settings.signup_tos|default('0') == 'implicit' %}
                <div class="text-center pt-1">
                    {# TODO: Make this translatable once support for placeholders is implemented #}
                    <span class="text-xs text-strata-subtle">By creating an account, you agree to our <a class="text-strata-brand hover:underline font-medium" href="{{ 'tos'|url }}" target="_blank">{{ 'Terms of Service'|trans }}</a> and <a class="text-strata-brand hover:underline font-medium" href="{{ 'privacy-policy'|url }}" target="_blank">{{ 'Privacy Policy'|trans }}</a>.</span>
                </div>
            {% endif %}
        </form>

        <div class="mt-6 pt-5 border-t border-strata-hairline flex flex-col sm:flex-row gap-2.5">
            <a class="strata-btn strata-btn-secondary flex-1 text-xs text-center justify-center" href="{{ 'login'|url }}">
                <svg class="size-3.5 text-strata-subtle" aria-hidden="true"><use href="#sign-in" /></svg>
                <span>{{ 'Already a User?'|trans }}</span>
            </a>
            {% if settings.show_password_reset_link %}
                <a class="strata-btn strata-btn-secondary flex-1 text-xs text-center justify-center" href="{{ 'password-reset'|url }}">
                    <svg class="size-3.5 text-strata-subtle" aria-hidden="true"><use href="#key" /></svg>
                    <span>{{ 'Forgot password?'|trans }}</span>
                </a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
