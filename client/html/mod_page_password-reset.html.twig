{% extends "layout_public.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'Reset Password'|trans }}{% endblock %}
{% block meta_description %}{{ 'Request a password reset link to regain access to your client account securely.'|trans }}{% endblock %}

{% block body_class %}page-password-reset{% endblock %}

{% block body %}
<div class="w-full max-w-md mx-auto" data-animate="fade-up">
    {% if settings.login_page_show_logo ?? '1' %}
        <div class="flex justify-center mb-6">
            {{ include('partial_company_logo.html.twig', {
                company: company,
                logo_url: public_logo_url,
                dark_logo_url: public_dark_logo_url,
                link_url: settings.login_page_logo_url|default('/'),
                link_target: '_blank',
                link_rel: 'noopener noreferrer',
                image_class: 'h-12 w-auto max-w-full object-contain',
                image_height: '48px',
                fallback_class: 'text-xl font-bold tracking-tight text-strata-strong'
            }) }}
        </div>
    {% endif %}

    <div class="relative bg-strata-base border border-strata-hairline rounded-2xl shadow-sm p-6 sm:p-8 overflow-hidden">
        {# Subtle top highlight #}
        <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-strata-line to-transparent" aria-hidden="true"></div>

        <div class="flex flex-col items-center text-center mb-6">
            <div class="size-11 rounded-xl bg-strata-brand/10 text-strata-brand flex items-center justify-center mb-3 shadow-xs">
                <svg class="size-5" aria-hidden="true"><use href="#key" /></svg>
            </div>
            <h1 class="text-xl font-semibold text-strata-strong tracking-tight">{{ 'Reset Your Password'|trans }}</h1>
            <p class="text-xs text-strata-subtle mt-1">{{ 'Enter your email to receive a password reset link and choose a new password.'|trans }}</p>
        </div>

        <form method="post" action="{{ 'client/reset_password'|api_url(role: 'guest') }}" class="auth space-y-4" {{ fb_api_form({message: 'A password reset confirmation email will be sent to you if we found an account with that email address.'|trans}) }}>
            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">

            <div>
                <label class="strata-label" for="email">{{ 'Email'|trans }}</label>
                <div class="relative">
                    <input class="strata-input pl-10" id="email" type="text" placeholder="{{ 'Enter your email address'|trans }}" name="email" value="{{ request.email }}" required="required" autofocus>
                    <div class="pointer-events-none absolute inset-y-0 left-0 pl-3 flex items-center text-strata-subtle">
                        <svg class="size-4" aria-hidden="true"><use href="#mail" /></svg>
                    </div>
                </div>
            </div>

            {{ mf.recaptcha }}

            <button type="submit" class="strata-btn strata-btn-primary w-full py-2.5 text-sm font-medium shadow-xs">
                <span>{{ 'Reset Password'|trans }}</span>
                <svg class="size-4" aria-hidden="true"><use href="#arrow-right" /></svg>
            </button>
        </form>

        <div class="mt-6 pt-5 border-t border-strata-hairline text-center">
            <a class="inline-flex items-center justify-center gap-1.5 text-xs text-strata-subtle hover:text-strata-strong transition-colors" href="{{ 'login'|url }}">
                <svg class="size-3.5" aria-hidden="true"><use href="#arrow-left" /></svg>
                <span>{{ 'Back to Login'|trans }}</span>
            </a>
        </div>
    </div>
</div>
{% endblock %}
