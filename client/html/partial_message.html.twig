{% if flashes is defined and flashes %}
    <div class="flex flex-col gap-3 mb-5">
        {% for label, messages in flashes %}
            {% if label in ['error', 'danger'] %}
                {% set alert_classes = 'bg-strata-danger-tint border-strata-danger/30 text-strata-danger' %}
                {% set icon_id = '#x-circle' %}
            {% elseif label == 'success' %}
                {% set alert_classes = 'bg-strata-success-tint border-strata-success/30 text-strata-success' %}
                {% set icon_id = '#check-circle' %}
            {% elseif label == 'warning' %}
                {% set alert_classes = 'bg-strata-warning-tint border-strata-warning/30 text-strata-warning' %}
                {% set icon_id = '#warning' %}
            {% else %}
                {% set alert_classes = 'bg-strata-info-tint border-strata-info/30 text-strata-info' %}
                {% set icon_id = '#info' %}
            {% endif %}

            {% for msg in messages %}
                <div class="rounded-xl border px-4 py-3 flex items-start gap-3 text-sm {{ alert_classes }}" role="alert">
                    <svg class="size-5 shrink-0 mt-0.5" aria-hidden="true"><use href="{{ icon_id }}" /></svg>
                    <div class="min-w-0">
                        <div class="font-semibold capitalize">{{ label|trans }}</div>
                        <p class="mt-0.5 text-strata-default">{{ msg }}</p>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}
