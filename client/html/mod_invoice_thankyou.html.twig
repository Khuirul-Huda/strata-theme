{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'invoices' %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'Thank You'|trans }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a class="hover:text-strata-strong transition-colors" href="{{ 'invoice'|url }}">{{ 'Invoices'|trans }}</a></li>
    <li class="active breadcrumb-item text-strata-strong font-medium" aria-current="page">{{ 'Thank You'|trans }}</li>
{% endblock %}

{% block content %}
{{ render_widgets('client.invoice.thankyou.before', { 'invoice': invoice }) }}

<div class="py-8" data-animate="scale-in">
    <div class="max-w-xl mx-auto strata-card shadow-xs text-center p-6 sm:p-10">
        <!-- Animated Success Icon -->
        <div class="size-16 rounded-full bg-strata-success-tint border border-strata-success/20 flex items-center justify-center text-strata-success mx-auto mb-4">
            <svg class="size-8 animate-bounce" aria-hidden="true"><use href="#check-circle" /></svg>
        </div>

        <!-- Heading & Description -->
        <h1 class="text-2xl font-bold tracking-tight text-strata-strong mb-2">{{ 'Payment Received'|trans }}</h1>
        <p class="text-sm text-strata-subtle leading-relaxed max-w-md mx-auto">
            {{ 'Your payment has been submitted and will be processed shortly. It may take some time for your invoice to be marked as paid.'|trans }}
        </p>

        <!-- Invoice Summary Box -->
        {% if invoice is defined and invoice %}
            <div class="my-6 p-4 rounded-xl bg-strata-recessed border border-strata-hairline text-left text-xs sm:text-sm space-y-2.5 max-w-md mx-auto">
                <div class="flex items-center justify-between">
                    <span class="text-strata-subtle">{{ 'Invoice'|trans }}</span>
                    <span class="font-semibold text-strata-strong strata-tabular">#{{ invoice.serie_nr }}</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-strata-subtle">{{ 'Amount'|trans }}</span>
                    <span class="font-bold text-strata-strong strata-tabular">{{ invoice.total|format_currency(invoice.currency ?? default_currency) }}</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-strata-subtle">{{ 'Status'|trans }}</span>
                    {{ mf.status_badge(invoice.status, 'invoice') }}
                </div>
            </div>
        {% endif %}

        <!-- Countdown and Progress Indicator -->
        <div class="my-6 max-w-md mx-auto space-y-2 text-xs text-strata-subtle">
            <div class="flex items-center justify-between">
                <span>{{ 'Redirecting back to invoice...'|trans }}</span>
                <span class="strata-tabular"><strong id="countdown" class="text-strata-strong font-semibold">60</strong> {{ 'seconds'|trans }}</span>
            </div>
            <div class="w-full h-1.5 rounded-full bg-strata-fill overflow-hidden" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                <div id="redirect-progress" class="h-full bg-strata-success transition-all duration-1000 ease-linear" style="width: 100%"></div>
            </div>
        </div>

        <!-- Next-Step Action Links -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <a href="{{ "invoice/#{invoice.hash}"|url }}" class="strata-btn strata-btn-primary">
                <svg class="size-4" aria-hidden="true"><use href="#receipt" /></svg>
                <span>{{ 'View Invoice'|trans }}</span>
            </a>
            <a href="{{ ''|url }}" class="strata-btn strata-btn-secondary">
                <svg class="size-4" aria-hidden="true"><use href="#layout-grid" /></svg>
                <span>{{ 'Dashboard'|trans }}</span>
            </a>
            <a href="{{ 'invoice'|url }}" class="strata-btn strata-btn-ghost">
                <svg class="size-4" aria-hidden="true"><use href="#arrow-left" /></svg>
                <span>{{ 'All Invoices'|trans }}</span>
            </a>
        </div>
    </div>
</div>

<script>
    (function() {
        let seconds = 60;
        const countdownEl = document.getElementById('countdown');
        const progressEl = document.getElementById('redirect-progress');
        const invoiceUrl = '{{ "invoice/#{invoice.hash}"|url }}';
        const timer = setInterval(function() {
            seconds--;
            if (countdownEl) countdownEl.textContent = seconds;
            if (progressEl) progressEl.style.width = ((seconds / 60) * 100) + '%';
            if (seconds <= 0) {
                clearInterval(timer);
                window.location = invoiceUrl;
            }
        }, 1000);
    })();
</script>

{{ render_widgets('client.invoice.thankyou.after', { 'invoice': invoice }) }}
{% endblock %}
