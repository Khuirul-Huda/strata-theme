{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'news' %}

{% block meta_title %}{{ post.title }}{% endblock %}
{% block meta_description %}{{ post.description }}{% endblock %}
{% block body_class %}news-post{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a class="hover:text-strata-strong transition-colors" href="{{ 'news'|url }}">{{ 'News'|trans }}</a></li>
    <li class="active breadcrumb-item text-strata-strong font-medium truncate max-w-xs sm:max-w-sm" aria-current="page">{{ post.title }}</li>
{% endblock %}

{% block opengraph %}
    <meta property="og:title" content="{{ post.title }}" />
    <meta property="og:type" content="article" />
    <meta property="og:description" content="{{ post.description }}" />
    <meta property="og:url" content="{{ guest.system_current_url|url }}" />
    {% if post.image %}<meta property="og:image" content="{{ post.image }}" />{% endif %}
    {% if post.author.name|default('') %}<meta property="article:author" content="{{ post.author.name }}" />{% endif %}

    {% if post.published_at %}<meta property="article:published_time" content="{{ post.published_at }}" />{% endif %}
    {% if post.updated_at %}<meta property="article:modified_time" content="{{ post.updated_at }}" />{% endif %}
    {% if post.expires_at %}<meta property="article:expiration_time" content="{{ post.expires_at }}" />{% endif %}
    {% if post.section %}<meta property="article:section" content="{{ post.section }}" />{% endif %}
    {% if post.tags|default([])|length > 0 %}<meta property="article:tag" content="{{ post.tags|join(', ') }}" />{% endif %}
{% endblock %}

{% block content %}
    <div class="max-w-4xl mx-auto space-y-6" data-animate="fade-up">
        <article class="rounded-2xl bg-strata-base border border-strata-hairline shadow-xs overflow-hidden">
            {% if post.image %}
                <div class="aspect-[21/9] w-full overflow-hidden border-b border-strata-hairline bg-strata-tint">
                    <img src="{{ post.image }}" alt="{{ post.title }}" class="w-full h-full object-cover" />
                </div>
            {% endif %}

            <div class="p-6 sm:p-8 border-b border-strata-hairline space-y-3">
                <div class="flex flex-wrap items-center gap-3 text-xs text-strata-subtle strata-tabular">
                    <span class="strata-badge strata-badge-brand">
                        <svg class="size-3" aria-hidden="true"><use href="#news" /></svg>
                        <span>{{ 'Announcement'|trans }}</span>
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <svg class="size-3.5" aria-hidden="true"><use href="#calendar" /></svg>
                        <span>{{ post.updated_at|format_datetime }}</span>
                    </span>
                    {% if post.author.name|default('') %}
                        <span class="inline-flex items-center gap-1.5">
                            <svg class="size-3.5" aria-hidden="true"><use href="#user" /></svg>
                            <span>{{ 'by'|trans }} {{ post.author.name }}</span>
                        </span>
                    {% endif %}
                </div>

                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-strata-strong leading-tight break-words">
                    {{ post.title }}
                </h1>
            </div>

            <div class="p-6 sm:p-8 md:p-10">
                <div class="prose max-w-none">
                    {{ (post.content ?? '')|markdown_to_html }}
                </div>
            </div>

            <div class="px-6 sm:px-8 py-4 border-t border-strata-hairline bg-strata-tint/40 flex items-center justify-between gap-3">
                <a href="{{ 'news'|url }}" class="strata-btn strata-btn-secondary strata-btn-sm">
                    <svg class="size-4" aria-hidden="true"><use href="#arrow-left" /></svg>
                    <span>{{ 'Back to the List'|trans }}</span>
                </a>
                <a href="{{ 'order'|url }}" class="strata-btn strata-btn-primary strata-btn-sm">
                    <span>{{ 'Explore Products'|trans }}</span>
                    <svg class="size-4" aria-hidden="true"><use href="#arrow-right" /></svg>
                </a>
            </div>
        </article>
    </div>
{% endblock %}
