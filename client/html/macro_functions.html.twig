{% macro status_badge(status, type) %}
    {% set status_title = status|replace({'_': " "})|title|trim %}
    {% if status_title == 'Active' %}
        {% set status_label = 'Active'|trans %}
    {% elseif status_title == 'Pending Setup' %}
        {% set status_label = 'Pending Setup'|trans %}
    {% elseif status_title == 'Failed Setup' %}
        {% set status_label = 'Failed Setup'|trans %}
    {% elseif status_title == 'Failed Renew' %}
        {% set status_label = 'Failed Renewal'|trans %}
    {% elseif status_title == 'Suspended' %}
        {% set status_label = 'Suspended'|trans %}
    {% elseif status_title == 'Canceled' %}
        {% set status_label = 'Canceled'|trans %}
    {% elseif status_title == 'Paid' %}
        {% set status_label = 'Paid'|trans %}
    {% elseif status_title == 'Unpaid' %}
        {% set status_label = 'Unpaid'|trans %}
    {% elseif status_title == 'Refunded' %}
        {% set status_label = 'Refunded'|trans %}
    {% else %}
        {% set status_label = status_title|trans %}
    {% endif %}

    {% set badge_success = 'bg-strata-success-tint text-strata-success border-strata-success/20' %}
    {% set badge_warning = 'bg-strata-warning-tint text-strata-warning border-strata-warning/20' %}
    {% set badge_danger = 'bg-strata-danger-tint text-strata-danger border-strata-danger/20' %}
    {% set badge_info = 'bg-strata-info-tint text-strata-info border-strata-info/20' %}
    {% set badge_neutral = 'bg-strata-fill text-strata-subtle border-strata-hairline' %}
    {% set badge_primary = 'bg-strata-brand/10 text-strata-brand border-strata-brand/20' %}

    {% if type == 'order' %}
        {% if status == 'active' %}{% set badge_class = badge_success %}
        {% elseif status == 'pending_setup' %}{% set badge_class = badge_warning %}
        {% elseif status == 'failed_setup' or status == 'suspended' or status == 'failed_renew' %}{% set badge_class = badge_danger %}
        {% elseif status == 'canceled' %}{% set badge_class = badge_neutral %}
        {% else %}{% set badge_class = badge_primary %}
        {% endif %}
    {% elseif type == 'ticket' %}
        {% if status == 'open' %}{% set badge_class = badge_success %}
        {% elseif status == 'on_hold' %}{% set badge_class = badge_warning %}
        {% elseif status == 'closed' %}{% set badge_class = badge_neutral %}
        {% else %}{% set badge_class = badge_primary %}
        {% endif %}
    {% elseif type == 'invoice' %}
        {% if status == 'paid' %}{% set badge_class = badge_success %}
        {% elseif status == 'unpaid' %}{% set badge_class = badge_warning %}
        {% elseif status == 'refunded' %}{% set badge_class = badge_info %}
        {% elseif status == 'canceled' %}{% set badge_class = badge_neutral %}
        {% else %}{% set badge_class = badge_primary %}
        {% endif %}
    {% elseif type == 'client' %}
        {% if status == 'active' %}{% set badge_class = badge_success %}
        {% elseif status == 'suspended' %}{% set badge_class = badge_danger %}
        {% elseif status == 'canceled' %}{% set badge_class = badge_neutral %}
        {% else %}{% set badge_class = badge_primary %}
        {% endif %}
    {% elseif type == 'subscription' %}
        {% if status == 'active' %}{% set badge_class = badge_success %}
        {% elseif status == 'canceled' %}{% set badge_class = badge_neutral %}
        {% elseif status == 'past_due' %}{% set badge_class = badge_danger %}
        {% else %}{% set badge_class = badge_primary %}
        {% endif %}
    {% elseif type == 'post' %}
        {% if status == 'published' %}{% set badge_class = badge_success %}
        {% elseif status == 'draft' %}{% set badge_class = badge_neutral %}
        {% else %}{% set badge_class = badge_primary %}
        {% endif %}
    {% elseif type == 'tx' %}
        {% if status == 'success' %}{% set badge_class = badge_success %}
        {% elseif status == 'failed' %}{% set badge_class = badge_danger %}
        {% elseif status == 'pending' %}{% set badge_class = badge_warning %}
        {% elseif status == 'refunded' %}{% set badge_class = badge_info %}
        {% else %}{% set badge_class = badge_primary %}
        {% endif %}
    {% else %}
        {% if status == 'active' or status == 'open' or status == 'paid' or status == 'published' %}{% set badge_class = badge_success %}
        {% elseif status == 'pending_setup' or status == 'on_hold' or status == 'unpaid' or status == 'pending' %}{% set badge_class = badge_warning %}
        {% elseif status == 'failed_setup' or status == 'suspended' or status == 'failed_renew' or status == 'canceled' or status == 'closed' or status == 'failed' %}{% set badge_class = badge_danger %}
        {% else %}{% set badge_class = badge_primary %}
        {% endif %}
    {% endif %}
    <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium whitespace-nowrap {{ badge_class }}">
        <span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span>
        <span>{{ status_label }}</span>
    </span>
{% endmacro %}

{% macro empty_list(colspan, message) %}
    <td class="py-10 px-4 text-center text-sm text-strata-subtle" colspan="{{ colspan|default(5) }}">{{ (message|default('The list is empty'))|trans }}</td>
{% endmacro empty_list %}
