{% set logo_url = logo_url|default(null) %}
{% set dark_logo_url = dark_logo_url|default(null) %}
{% set link_url = link_url|default('/'|url) %}
{% set link_class = link_class|default('') %}
{% set link_rel = link_rel|default(null) %}
{% set image_class = image_class|default('') %}
{% set image_height = image_height|default(null) %}
{% set image_style = image_style|default(null) %}
{% set fallback_class = fallback_class|default('') %}
{% set show_mobile_name = show_mobile_name|default(false) %}

<a{% if link_class %} class="{{ link_class }}"{% endif %} href="{{ link_url }}"{% if link_target is defined %} target="{{ link_target }}"{% endif %}{% if link_rel %} rel="{{ link_rel }}"{% endif %}>
    {% if logo_url or dark_logo_url %}
        <img class="hide-theme-light [[data-mode=light]_&]:hidden{% if image_class %} {{ image_class }}{% endif %}" src="{{ dark_logo_url|default(logo_url) }}" alt="{{ company.name }}" title="{{ company.name }}"{% if image_height %} height="{{ image_height }}"{% endif %}{% if image_style %} style="{{ image_style }}"{% endif %}>
        <img class="hide-theme-dark [[data-mode=dark]_&]:hidden{% if image_class %} {{ image_class }}{% endif %}" src="{{ logo_url|default(dark_logo_url) }}" alt="{{ company.name }}" title="{{ company.name }}"{% if image_height %} height="{{ image_height }}"{% endif %}{% if image_style %} style="{{ image_style }}"{% endif %}>
        {% if show_mobile_name %}
            <span class="sm:hidden">{{ company.name }}</span>
        {% endif %}
    {% else %}
        <span class="inline-flex items-center gap-2{% if fallback_class %} {{ fallback_class }}{% endif %}">
            <svg class="size-5 shrink-0 text-strata-brand" aria-hidden="true"><use href="#strata-mark" /></svg>
            <span>{{ company.name }}</span>
        </span>
    {% endif %}
</a>
