{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'support' %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'Support Tickets'|trans }}{% endblock %}
{% block page_header %}{{ 'Support Tickets'|trans }}{% endblock %}

{% block body_class %}support-tickets{% endblock %}
{% block breadcrumb %}
    <li class="active breadcrumb-item text-strata-strong font-medium" aria-current="page">{{ 'Support Tickets'|trans }}</li>
{% endblock %}

{% block head %}
    {{ wysiwyg('.editor-textarea') }}
{% endblock %}

{% block content %}
<div class="flex flex-col gap-6" data-animate="fade-up">
    <div class="strata-card">
        <div class="strata-card-header flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-xl font-bold tracking-tight text-strata-strong">{{ 'Support Tickets'|trans }}</h1>
                <p class="text-sm text-strata-subtle mt-0.5">{{ 'Need an answer? We are here to help!'|trans }}</p>
            </div>
            <div>
                <button type="button"
                        class="strata-btn strata-btn-primary"
                        data-open-ticket-modal
                        data-bs-toggle="modal"
                        data-bs-target="#open-ticket-modal">
                    <svg class="size-4" aria-hidden="true"><use href="#plus" /></svg>
                    <span>{{ 'New Ticket'|trans }}</span>
                </button>
            </div>
        </div>

        <div class="p-0">
            {% set tickets = client.support_ticket_get_list({"per_page": 10, "page": request.page, "deep": 0, "include_first": 0}) %}
            {% if tickets.list %}
                <div class="overflow-x-auto">
                    <table class="strata-table" data-stagger>
                        <thead>
                            <tr>
                                <th scope="col" class="w-20">{{ 'ID'|trans }}</th>
                                <th scope="col">{{ 'Subject'|trans }}</th>
                                <th scope="col">{{ 'Help Desk'|trans }}</th>
                                <th scope="col">{{ 'Status'|trans }}</th>
                                <th scope="col">{{ 'Submitted'|trans }}</th>
                                <th scope="col" class="text-right">{{ 'Actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for i, ticket in tickets.list %}
                                <tr data-stagger-item class="hover:bg-strata-tint transition-colors">
                                    <td class="strata-tabular font-medium text-strata-subtle">#{{ ticket.id }}</td>
                                    <td>
                                        <a href='{{ "support/ticket/#{ticket.id}"|url }}' class="font-medium text-strata-strong hover:text-strata-brand transition-colors">
                                            {{ ticket.subject|truncate(40) }}
                                        </a>
                                    </td>
                                    <td class="text-strata-default">{{ ticket.helpdesk.name }}</td>
                                    <td>
                                        {{ mf.status_badge(ticket.status, 'ticket') }}
                                    </td>
                                    <td class="strata-tabular text-sm text-strata-subtle">{{ ticket.created_at|timeago }} {{ 'ago'|trans }}</td>
                                    <td class="text-right">
                                        {% if ticket.status == 'closed' %}
                                            <a href='{{ "support/ticket/#{ticket.id}"|url }}' class="strata-btn strata-btn-secondary strata-btn-sm">
                                                {{ 'View'|trans }}
                                            </a>
                                        {% else %}
                                            <a href='{{ "support/ticket/#{ticket.id}"|url }}#reply-to' class="strata-btn strata-btn-primary strata-btn-sm">
                                                {{ 'Reply'|trans }}
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if tickets.pages > 1 %}
                    <div class="p-4 border-t border-strata-hairline">
                        {{ include('partial_pagination.html.twig', { 'list': tickets, 'url': 'support' }) }}
                    </div>
                {% endif %}
            {% else %}
                <div class="py-12 px-4 flex flex-col items-center justify-center text-center">
                    <div class="inline-flex items-center justify-center size-12 rounded-xl bg-strata-fill text-strata-subtle mb-3">
                        <svg class="size-6" aria-hidden="true"><use href="#ticket" /></svg>
                    </div>
                    <h3 class="text-base font-semibold text-strata-strong">{{ 'No Support Tickets'|trans }}</h3>
                    <p class="text-sm text-strata-subtle mt-1 mb-4">{{ 'Need assistance? Open a new support ticket and our team will get back to you.'|trans }}</p>
                    <button type="button"
                            class="strata-btn strata-btn-primary strata-btn-sm"
                            data-open-ticket-modal
                            data-bs-toggle="modal"
                            data-bs-target="#open-ticket-modal">
                        <svg class="size-4" aria-hidden="true"><use href="#plus" /></svg>
                        <span>{{ 'Open New Ticket'|trans }}</span>
                    </button>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<dialog id="open-ticket-modal" class="strata-dialog m-auto rounded-2xl bg-strata-base text-strata-default border border-strata-line shadow-2xl p-0 max-w-xl w-[calc(100%-2rem)] backdrop:bg-black/50 backdrop:backdrop-blur-xs">
    <div class="flex items-center justify-between px-6 py-4 border-b border-strata-hairline">
        <h2 class="text-base font-semibold text-strata-strong flex items-center gap-2">
            <svg class="size-5 text-strata-brand" aria-hidden="true"><use href="#ticket" /></svg>
            <span>{{ 'Open New Ticket'|trans }}</span>
        </h2>
        <button type="button"
                class="inline-flex items-center justify-center size-8 rounded-lg text-strata-subtle hover:text-strata-strong hover:bg-strata-fill-hover transition-colors cursor-pointer"
                data-close-ticket-modal
                aria-label="{{ 'Close'|trans }}">
            <svg class="size-4" aria-hidden="true"><use href="#x" /></svg>
        </button>
    </div>
    <form action="" method="post" id="ticket-submit" class="p-6 flex flex-col gap-4">
        <div>
            <label for="support-helpdesk-id" class="strata-label">{{ 'Helpdesk'|trans }}</label>
            {{ mf.selectbox('support_helpdesk_id', client.support_helpdesk_get_pairs, request.support_helpdesk_id, 1) }}
        </div>
        <div>
            <label for="subject" class="strata-label">{{ 'Subject'|trans }}</label>
            <input type="text" name="subject" class="strata-input" id="subject" required aria-describedby="subject" value="{{ request.subject|e }}">
        </div>
        {% if guest.support_kb_suggestions_enabled({ 'area': 'ticket' }) %}
            {{ include('mod_support_kb_suggestions.html.twig', { 'input_id': 'subject' }) }}
        {% endif %}
        <div>
            <label for="message" class="strata-label">{{ 'Message'|trans }}</label>
            <textarea name="content" class="editor-textarea strata-textarea" id="message" aria-describedby="message" rows="5" required>{{ request.content|e }}</textarea>
        </div>
        <div class="flex items-center justify-end gap-2 pt-2 border-t border-strata-hairline mt-2">
            <button type="button" class="strata-btn strata-btn-secondary" data-close-ticket-modal>{{ 'Cancel'|trans }}</button>
            <button type="submit" class="strata-btn strata-btn-primary">{{ 'Submit'|trans }}</button>
        </div>
    </form>
</dialog>
{% endblock %}

{% block js %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const submitTicket = document.getElementById('ticket-submit');
        const modal = document.getElementById('open-ticket-modal');
        const openButtons = document.querySelectorAll('[data-open-ticket-modal]');
        const closeButtons = document.querySelectorAll('[data-close-ticket-modal]');

        const openModal = () => {
            if (modal && typeof modal.showModal === 'function') {
                modal.showModal();
            } else if (modal) {
                modal.setAttribute('open', '');
            }
        };

        const closeModal = () => {
            if (modal && typeof modal.close === 'function') {
                modal.close();
            } else if (modal) {
                modal.removeAttribute('open');
            }
        };

        openButtons.forEach(btn => btn.addEventListener('click', (e) => {
            e.preventDefault();
            openModal();
        }));

        closeButtons.forEach(btn => btn.addEventListener('click', (e) => {
            e.preventDefault();
            closeModal();
        }));

        modal?.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });

        submitTicket?.addEventListener('submit', (event) => {
            event.preventDefault();
            FOSSBilling.api.client.post('support/ticket_create', FOSSBilling.tools.serializeFormDataToObject(new FormData(submitTicket)),
                (res) => {
                    window.location = "{{ 'support/ticket'|url }}" + '/' + res;
                },
                (res) => {
                    FOSSBilling.message(`${res.message} (${res.code})`, 'error');
                });
        });

        {% if request.ticket %}
            openModal();
        {% endif %}
    });
</script>
{% endblock %}
