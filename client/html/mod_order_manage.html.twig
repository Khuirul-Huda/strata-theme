</div>
{% endblock %}

{% block js %}
{% autoescape "js" %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Universal modal helpers (works with or without bootstrap JS bundle)
        const modalHelper = {
            show: function(el) {
                if (!el) return;
                el.style.display = 'flex';
                el.classList.add('show');
                document.body.classList.add('overflow-hidden');
            },
            hide: function(el) {
                if (!el) return;
                el.classList.remove('show');
                el.style.display = 'none';
                document.body.classList.remove('overflow-hidden');
            }
        };

        // Bootstrap mock / bridge so existing modal calls always succeed
        window.bootstrap = window.bootstrap || {};
        window.bootstrap.Modal = window.bootstrap.Modal || {
            getInstance: function(el) {
                return {
                    hide: () => modalHelper.hide(el),
                    show: () => modalHelper.show(el)
                };
            },
            getOrCreateInstance: function(el) {
                return this.getInstance(el);
            }
        };

        // Bind modal trigger buttons
        document.querySelectorAll('[data-bs-toggle="modal"]').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const targetSelector = this.getAttribute('data-bs-target');
                if (targetSelector) {
                    const modalEl = document.querySelector(targetSelector);
                    modalHelper.show(modalEl);
                }
            });
        });

        // Bind modal dismiss buttons and backdrop clicks
        document.querySelectorAll('.modal').forEach(modalEl => {
            modalEl.querySelectorAll('[data-bs-dismiss="modal"]').forEach(closeBtn => {
                closeBtn.addEventListener('click', () => modalHelper.hide(modalEl));
            });

            modalEl.addEventListener('click', function(e) {
                if (e.target === modalEl) {
                    modalHelper.hide(modalEl);
                }
            });
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal.show').forEach(m => modalHelper.hide(m));
            }
        });

        // Form Handlers
        const cancelRequestForm = document.getElementById('cancel-request-form');
        const upgradeRequestForm = document.getElementById('upgrade-request-form');
        const openTicketForm = document.getElementById('open-ticket-form');

        if (cancelRequestForm) {
            cancelRequestForm.addEventListener('submit', function(event) {
                event.preventDefault();
                FOSSBilling.api.client.post('support/ticket_create', FOSSBilling.tools.serializeFormDataToObject(new FormData(cancelRequestForm)),
                    () => {
                        FOSSBilling.message("{{ 'Service cancellation request received'|trans }}", 'success');
                        modalHelper.hide(document.getElementById('cancel-request-modal'));
                    },
                    (res) => {
                        FOSSBilling.message(`${res.message} (${res.code})`, 'error');
                    });
            });
        }

        if (upgradeRequestForm) {
            upgradeRequestForm.addEventListener('submit', function(event) {
                event.preventDefault();
                FOSSBilling.api.client.post('support/ticket_create', FOSSBilling.tools.serializeFormDataToObject(new FormData(upgradeRequestForm)),
                    () => {
                        FOSSBilling.message("{{ 'Service upgrade request received'|trans }}", 'success');
                        modalHelper.hide(document.getElementById('upgrade-request-modal'));
                    },
                    (res) => {
                        FOSSBilling.message(`${res.message} (${res.code})`, 'error');
                    });
            });
        }

        if (openTicketForm) {
            openTicketForm.addEventListener('submit', function(event) {
                event.preventDefault();
                FOSSBilling.api.client.post('support/ticket_create', FOSSBilling.tools.serializeFormDataToObject(new FormData(openTicketForm)),
                    () => {
                        FOSSBilling.message("{{ 'Ticket was submitted. If you want to track conversation please go to support section'|trans }}", 'success');
                        modalHelper.hide(document.getElementById('open-ticket-modal'));
                    },
                    (res) => {
                        FOSSBilling.message(`${res.message} (${res.code})`, 'error');
                    });
            });
        }
    });
</script>
{% endautoescape %}
{% endblock %}
