{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'kb' %}

{% block meta_title %}{{ article.title }}{% endblock %}
{% block meta_description %}{{ (article.content ?? '')|markdown_to_html|striptags|trim|truncate(160) }}{% endblock %}

{% block body_class %}kb-article{% endblock %}
{% block head %}{{ 'css/markdown.css' | public_asset_url | stylesheet_tag }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <a class="hover:text-strata-strong transition-colors" href="{{ 'support/kb'|url }}">{{ 'Knowledge Base'|trans }}</a>
    </li>
    <li class="breadcrumb-item">
        <a class="hover:text-strata-strong transition-colors" href='{{ "support/kb/#{article.category.slug}"|url }}'>{{ article.category.title }}</a>
    </li>
    <li class="active breadcrumb-item text-strata-strong font-medium truncate max-w-xs sm:max-w-sm" aria-current="page">{{ article.title }}</li>
{% endblock %}

{% block content %}
{% set related_articles = guest.support_kb_article_get_list({ 'kb_article_category_id': article.category.id, 'per_page': 6 }).list|filter(related_article => related_article.id != article.id)|slice(0, 5) %}

<div class="grid grid-cols-1 lg:grid-cols-4 gap-8" data-animate="fade-up">
    {# Main Article Column #}
    <article class="lg:col-span-3 flex flex-col gap-6">
        <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
                <a href='{{ "support/kb/#{article.category.slug}"|url }}' class="strata-badge strata-badge-brand">
                    <svg class="size-3" aria-hidden="true"><use href="#book" /></svg>
                    <span>{{ article.category.title }}</span>
                </a>
                {% if article.updated_at %}
                    <span class="inline-flex items-center gap-1.5 text-xs text-strata-subtle strata-tabular">
                        <svg class="size-3.5" aria-hidden="true"><use href="#clock" /></svg>
                        <span>{{ 'Updated'|trans }} {{ '%time% ago'|trans({ '%time%': article.updated_at|timeago }) }}</span>
                    </span>
                {% endif %}
                {% if guest.support_kb_article_views_enabled %}
                    <span class="inline-flex items-center gap-1.5 text-xs text-strata-subtle strata-tabular">
                        <svg class="size-3.5" aria-hidden="true"><use href="#eye" /></svg>
                        <span>{{ article.views }} {{ 'views'|trans }}</span>
                    </span>
                {% endif %}
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-strata-strong break-words">{{ article.title }}</h1>
        </div>

        {# Article Body #}
        <div class="rounded-2xl bg-strata-base border border-strata-hairline p-6 sm:p-8 md:p-10 shadow-xs">
            <article class="kb-article-content markdown-body bg-transparent text-reset">
                {{ (article.content ?? '')|markdown_to_html }}
            </article>
        </div>

        {# Still need help #}
        <div class="rounded-xl bg-strata-elevated border border-strata-line p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3">
                <div class="size-10 rounded-lg bg-strata-brand/10 text-strata-brand flex items-center justify-center shrink-0">
                    <svg class="size-5" aria-hidden="true"><use href="#lifebuoy" /></svg>
                </div>
                <div>
                    <h2 class="text-base font-semibold text-strata-strong">{{ 'Still need help?'|trans }}</h2>
                    <p class="text-xs sm:text-sm text-strata-subtle mt-0.5">{{ 'If this article did not answer your question, our support team can help.'|trans }}</p>
                </div>
            </div>
            <a href="{{ 'support/contact-us'|url }}" class="strata-btn strata-btn-primary shrink-0">
                <svg class="size-4" aria-hidden="true"><use href="#lifebuoy" /></svg>
                <span>{{ 'Contact support'|trans }}</span>
            </a>
        </div>

        {# Navigation #}
        <div class="flex flex-wrap items-center gap-3 pt-2">
            <a href="{{ 'support/kb'|url }}" class="strata-btn strata-btn-secondary strata-btn-sm">
                <svg class="size-4" aria-hidden="true"><use href="#arrow-left" /></svg>
                <span>{{ 'Browse all articles'|trans }}</span>
            </a>
            <a href='{{ "support/kb/#{article.category.slug}"|url }}' class="strata-btn strata-btn-secondary strata-btn-sm">
                <span>{{ 'More in this category'|trans }}</span>
                <svg class="size-4" aria-hidden="true"><use href="#arrow-right" /></svg>
            </a>
        </div>
    </article>

    {# Sidebar #}
    <aside class="lg:col-span-1 flex flex-col gap-6">
        <div class="sticky top-20 flex flex-col gap-6">
            {# Category card #}
            <div class="strata-card p-5">
                <span class="text-xs font-semibold uppercase tracking-wider text-strata-subtle block mb-1">{{ 'Category'|trans }}</span>
                <a class="text-base font-bold text-strata-strong hover:text-strata-brand transition-colors block mb-4"
                   href='{{ "support/kb/#{article.category.slug}"|url }}'>
                    {{ article.category.title }}
                </a>
                <a class="strata-btn strata-btn-secondary strata-btn-sm w-full" href="{{ 'support/kb'|url }}">
                    <svg class="size-4" aria-hidden="true"><use href="#book" /></svg>
                    <span>{{ 'Knowledge Base'|trans }}</span>
                </a>
            </div>

            {# Related articles #}
            <div class="strata-card">
                <div class="strata-card-header">
                    <h2 class="text-sm font-semibold text-strata-strong flex items-center gap-1.5">
                        <svg class="size-4 text-strata-brand" aria-hidden="true"><use href="#file-text" /></svg>
                        <span>{{ 'Related articles'|trans }}</span>
                    </h2>
                </div>
                <div class="divide-y divide-strata-hairline">
                    {% if related_articles %}
                        {% for related_article in related_articles %}
                            <a class="flex items-center gap-2.5 p-3 text-xs font-medium text-strata-default hover:text-strata-brand hover:bg-strata-tint transition-colors group"
                               href='{{ "support/kb/#{related_article.category.slug}/#{related_article.slug}"|url }}'>
                                <svg class="size-3.5 text-strata-subtle group-hover:text-strata-brand shrink-0 transition-colors" aria-hidden="true"><use href="#file-text" /></svg>
                                <span class="line-clamp-2">{{ related_article.title }}</span>
                            </a>
                        {% endfor %}
                    {% else %}
                        <div class="p-4 text-xs text-strata-subtle">{{ 'No related articles yet.'|trans }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </aside>
</div>
{% endblock %}
