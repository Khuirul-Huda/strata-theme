{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'services' %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'My Products & Services'|trans }}{% endblock %}

{% block body_class %}order-list{% endblock %}

{% block breadcrumb %}
    <li class="active breadcrumb-item text-strata-strong font-medium" aria-current="page">{{ 'Services'|trans }}</li>
{% endblock %}

{% block content %}
<div class="space-y-6" data-animate="fade-up">
    {# Header & Action Bar #}
    <div class="rounded-2xl bg-strata-base border border-strata-hairline p-6 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-strata-strong mb-1">{{ 'My Products & Services'|trans }}</h1>
            <p class="text-sm text-strata-subtle">{{ 'All of your orders are displayed here. Click on any service to get full information about it.'|trans }}</p>
        </div>

        <a href="{{ 'order'|url }}" class="strata-btn strata-btn-primary inline-flex items-center gap-2 self-start md:self-auto">
            <svg class="size-4" aria-hidden="true"><use href="#plus" /></svg>
            <span>{{ 'Order New Service'|trans }}</span>
        </a>
    </div>

    {# Search & Status Filters #}
    <div class="rounded-2xl bg-strata-base border border-strata-hairline p-4 shadow-xs">
        <form method="get" action="{{ 'order/service'|url }}" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div class="relative flex-1 min-w-0">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-strata-subtle">
                    <svg class="size-4" aria-hidden="true"><use href="#search" /></svg>
                </div>
                <input type="text" name="search" value="{{ request.search|default('') }}"
                       placeholder="{{ 'Search services by name...'|trans }}"
                       class="w-full rounded-lg bg-strata-control border border-strata-line pl-9 pr-3 py-2 text-sm text-strata-default placeholder:text-strata-placeholder focus:outline-none focus:ring-2 focus:ring-strata-focus">
            </div>

            <div class="w-full sm:w-48 shrink-0">
                <label for="status-filter" class="sr-only">{{ 'Filter by Status'|trans }}</label>
                <select id="status-filter" name="status" class="w-full rounded-lg bg-strata-control border border-strata-line px-3 py-2 text-sm text-strata-default focus:outline-none focus:ring-2 focus:ring-strata-focus cursor-pointer">
                    <option value="">{{ 'All Statuses'|trans }}</option>
                    <option value="active"{% if request.status == 'active' %} selected="selected"{% endif %}>{{ 'Active'|trans }}</option>
                    <option value="pending_setup"{% if request.status == 'pending_setup' %} selected="selected"{% endif %}>{{ 'Pending Setup'|trans }}</option>
                    <option value="suspended"{% if request.status == 'suspended' %} selected="selected"{% endif %}>{{ 'Suspended'|trans }}</option>
                    <option value="canceled"{% if request.status == 'canceled' %} selected="selected"{% endif %}>{{ 'Canceled'|trans }}</option>
                </select>
            </div>

            <div class="flex items-center gap-2">
                <button type="submit" class="strata-btn strata-btn-secondary flex-1 sm:flex-initial justify-center">
                    <span>{{ 'Filter'|trans }}</span>
                </button>
                {% if request.search or request.status %}
                    <a href="{{ 'order/service'|url }}" class="strata-btn strata-btn-ghost strata-btn-sm text-strata-subtle hover:text-strata-strong">
                        <svg class="size-3.5" aria-hidden="true"><use href="#x" /></svg>
                        <span>{{ 'Clear'|trans }}</span>
                    </a>
                {% endif %}
            </div>
        </form>
    </div>

    {# Orders Table & Pagination #}
    {% set orders = client.order_get_list({"per_page": 10, "page": request.page, "hide_addons": 1, "search": request.search, "status": request.status}) %}

    {% if orders.list|length > 0 %}
        <div class="rounded-2xl bg-strata-base border border-strata-hairline overflow-hidden shadow-xs">
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-strata-default">
                    <thead>
                        <tr class="bg-strata-tint border-b border-strata-line text-left text-xs font-semibold text-strata-subtle">
                            <th class="py-3 px-4 w-28">{{ 'Order ID'|trans }}</th>
                            <th class="py-3 px-4">{{ 'Product / Service'|trans }}</th>
                            <th class="py-3 px-4">{{ 'Price'|trans }}</th>
                            <th class="py-3 px-4">{{ 'Next Due Date'|trans }}</th>
                            <th class="py-3 px-4">{{ 'Status'|trans }}</th>
                            <th class="py-3 px-4 text-right w-28">{{ 'Actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-strata-hairline">
                        {% for order in orders.list %}
                            <tr class="hover:bg-strata-elevated transition-colors group">
                                <td class="py-3.5 px-4 font-medium text-strata-strong strata-tabular whitespace-nowrap">
                                    <a href="{{ 'order/service/manage/' ~ order.id|url }}" class="text-strata-brand hover:underline">
                                        #{{ order.id }}
                                    </a>
                                </td>
                                <td class="py-3.5 px-4 font-medium text-strata-strong">
                                    <a href="{{ 'order/service/manage/' ~ order.id|url }}" class="group-hover:text-strata-brand transition-colors">
                                        {{ order.title }}
                                    </a>
                                </td>
                                <td class="py-3.5 px-4 font-semibold text-strata-strong strata-tabular whitespace-nowrap">
                                    {{ order.total|format_currency(order.currency ?? default_currency) }}
                                    {% if order.period %}
                                        <span class="text-xs font-normal text-strata-subtle">/ {{ order.period|period_title }}</span>
                                    {% endif %}
                                </td>
                                <td class="py-3.5 px-4 text-strata-subtle whitespace-nowrap">
                                    {% if order.expires_at %}
                                        <span class="strata-tabular">{{ order.expires_at|format_date }}</span>
                                    {% else %}
                                        <span class="text-strata-inactive">-</span>
                                    {% endif %}
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    {{ mf.status_badge(order.status, 'order') }}
                                </td>
                                <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                    <a class="strata-btn strata-btn-secondary strata-btn-sm inline-flex items-center gap-1 group-hover:border-strata-brand/40 transition-colors"
                                       href="{{ 'order/service/manage/' ~ order.id|url }}">
                                        <span>{{ 'Manage'|trans }}</span>
                                        <svg class="size-3 text-strata-subtle" aria-hidden="true"><use href="#chevron-right" /></svg>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if orders.pages > 1 %}
                <div class="p-4 border-t border-strata-hairline bg-strata-recessed/50 flex justify-center">
                    {{ include('partial_pagination.html.twig', { 'list': orders, 'url': 'order/service' }) }}
                </div>
            {% endif %}
        </div>
    {% else %}
        {# Empty State #}
        <div class="rounded-2xl bg-strata-base border border-strata-hairline p-12 text-center flex flex-col items-center justify-center shadow-xs">
            <div class="size-14 rounded-2xl bg-strata-fill flex items-center justify-center text-strata-subtle mb-4">
                <svg class="size-7" aria-hidden="true"><use href="#package" /></svg>
            </div>
            {% if request.search or request.status %}
                <h3 class="text-base font-semibold text-strata-strong mb-1">{{ 'No matching services found'|trans }}</h3>
                <p class="text-sm text-strata-subtle max-w-sm mb-5">{{ 'There are no services matching your search or filter query. Try adjusting your search term.'|trans }}</p>
                <a href="{{ 'order/service'|url }}" class="strata-btn strata-btn-secondary strata-btn-sm">
                    <span>{{ 'Reset Filters'|trans }}</span>
                </a>
            {% else %}
                <h3 class="text-base font-semibold text-strata-strong mb-1">{{ 'No services yet'|trans }}</h3>
                <p class="text-sm text-strata-subtle max-w-sm mb-5">{{ 'You have not placed any orders yet. Browse our products to find the perfect plan for you.'|trans }}</p>
                <a href="{{ 'order'|url }}" class="strata-btn strata-btn-primary">
                    <svg class="size-4" aria-hidden="true"><use href="#plus" /></svg>
                    <span>{{ 'Browse Products & Services'|trans }}</span>
                </a>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
