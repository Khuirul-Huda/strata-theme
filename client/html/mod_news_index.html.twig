{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'news' %}

{% block meta_title %}{{ 'News'|trans }}{% endblock %}
{% block page_header %}{{ 'News & Announcements'|trans }}{% endblock %}
{% block body_class %}news-index{% endblock %}

{% block breadcrumb %}
    <li class="active breadcrumb-item text-strata-strong font-medium" aria-current="page">{{ 'News'|trans }}</li>
{% endblock %}

{% block content %}
    {% set posts = guest.news_get_list({ "page": request.page, "per_page": 6 }) %}

    <div class="space-y-6" data-animate="fade-up">
        <!-- Page Header -->
        <div class="rounded-2xl bg-strata-base border border-strata-hairline p-6 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3.5">
                <div class="size-11 rounded-xl bg-strata-brand/10 text-strata-brand border border-strata-brand/15 flex items-center justify-center shrink-0">
                    <svg class="size-5" aria-hidden="true"><use href="#news" /></svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold tracking-tight text-strata-strong">{{ 'News & Announcements'|trans }}</h1>
                    <p class="text-sm text-strata-subtle mt-1">{{ 'Track our latest information.'|trans }}</p>
                </div>
            </div>
            {% if posts.total %}
                <span class="strata-badge strata-badge-neutral strata-tabular self-start sm:self-center">
                    {{ posts.total }} {{ (posts.total == 1 ? 'post' : 'posts')|trans }}
                </span>
            {% endif %}
        </div>

        {% if posts.list|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5" data-stagger>
                {% for i, post in posts.list %}
                    <article class="bg-strata-base border border-strata-hairline rounded-2xl shadow-xs hover:border-strata-line transition-all flex flex-col justify-between overflow-hidden group" data-stagger-item>
                        <div>
                            {% if post.image %}
                                <a href='{{ "news/#{post.slug}"|url }}' class="block aspect-[16/9] overflow-hidden border-b border-strata-hairline bg-strata-tint">
                                    <img src="{{ post.image }}" alt="{{ post.title }}" class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300" loading="lazy" />
                                </a>
                            {% endif %}
                            <div class="p-6 space-y-3">
                                <div class="flex flex-wrap items-center gap-2 text-xs text-strata-subtle strata-tabular">
                                    <span class="inline-flex items-center gap-1.5">
                                        <svg class="size-3.5 text-strata-brand" aria-hidden="true"><use href="#calendar" /></svg>
                                        <span>{{ post.updated_at|format_datetime }}</span>
                                    </span>
                                    {% if post.author.name|default('') %}
                                        <span>&middot;</span>
                                        <span>{{ post.author.name }}</span>
                                    {% endif %}
                                </div>

                                <h2 class="text-lg font-bold tracking-tight text-strata-strong group-hover:text-strata-brand transition-colors leading-snug">
                                    <a href='{{ "news/#{post.slug}"|url }}'>{{ post.title }}</a>
                                </h2>

                                <div class="prose prose-sm max-w-none text-strata-subtle line-clamp-4">
                                    {% if post.excerpt %}
                                        {{ (post.excerpt ?? '')|markdown_to_html }}
                                    {% else %}
                                        {{ (post.content ?? '')|truncate(240)|markdown_to_html }}
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="px-6 py-4 border-t border-strata-hairline bg-strata-tint/40 flex items-center justify-between">
                            <a class="inline-flex items-center gap-1.5 text-xs font-semibold text-strata-brand hover:underline"
                               href='{{ "news/#{post.slug}"|url }}'>
                                <span>{{ 'Continue reading'|trans }}</span>
                                <svg class="size-3.5 group-hover:translate-x-0.5 transition-transform" aria-hidden="true"><use href="#chevron-right" /></svg>
                            </a>
                        </div>
                    </article>
                {% endfor %}
            </div>

            {% if posts.pages > 1 %}
                <div class="pt-2 flex justify-center">
                    {{ include('partial_pagination.html.twig', { 'list': posts, 'url': 'news' }) }}
                </div>
            {% endif %}
        {% else %}
            <div class="rounded-2xl bg-strata-base border border-strata-hairline p-12 text-center shadow-xs">
                <div class="size-12 rounded-xl bg-strata-fill text-strata-subtle flex items-center justify-center mx-auto mb-3">
                    <svg class="size-6" aria-hidden="true"><use href="#news" /></svg>
                </div>
                <p class="text-sm font-medium text-strata-strong">{{ 'No news or announcements'|trans }}</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
