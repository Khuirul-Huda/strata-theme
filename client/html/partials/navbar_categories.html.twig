{% set nav_categories = nav_categories|default(guest.product_category_get_list({'per_page': 12}).list|default([])) %}
{% set is_order_active = current_active_menu|default('') == 'order' %}
{% set trigger_label = label|default('Products'|trans) %}

<details class="relative group" data-dropdown data-nav-dropdown>
    <summary class="list-none cursor-pointer inline-flex items-center gap-1.5 h-9 px-3 rounded-lg text-sm font-medium transition-colors select-none {% if is_order_active %}bg-strata-fill text-strata-strong{% else %}text-strata-subtle hover:text-strata-strong hover:bg-strata-fill-hover{% endif %}">
        <span>{{ trigger_label }}</span>
        <svg class="size-3.5 text-strata-subtle transition-transform duration-150 group-open:rotate-180" aria-hidden="true"><use href="#chevron-down" /></svg>
    </summary>

    <div class="strata-dropdown-panel absolute {{ align|default('left') == 'right' ? 'right-0' : 'left-0' }} mt-2 w-72 sm:w-80 rounded-xl bg-strata-overlay border border-strata-line shadow-xl p-2 z-50" role="menu">
        <div class="px-2.5 py-1.5 flex items-center justify-between text-[11px] font-semibold uppercase tracking-wider text-strata-subtle">
            <span>{{ 'Product Categories'|trans }}</span>
            {% if nav_categories|length > 0 %}
                <span class="strata-tabular">{{ nav_categories|length }}</span>
            {% endif %}
        </div>

        {% if nav_categories|length > 0 %}
            <div class="space-y-1 max-h-72 overflow-y-auto my-1">
                {% for category in nav_categories %}
                    {% set product_count = category.products|default([])|length %}
                    <a href="{{ 'order'|url(query: {'category': category.id}) }}"
                       class="flex items-start gap-3 px-2.5 py-2 rounded-lg hover:bg-strata-fill-hover transition-colors group/item"
                       role="menuitem">
                        <div class="size-8 rounded-lg bg-strata-brand/10 text-strata-brand border border-strata-brand/15 flex items-center justify-center shrink-0 mt-0.5">
                            <svg class="size-4" aria-hidden="true"><use href="#package" /></svg>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-sm font-medium text-strata-strong group-hover/item:text-strata-brand transition-colors truncate">{{ category.title }}</span>
                                <span class="inline-flex items-center rounded-full bg-strata-fill px-2 py-0.5 text-[11px] font-medium text-strata-subtle strata-tabular shrink-0">
                                    {{ product_count }}
                                </span>
                            </div>
                            {% if category.description %}
                                <p class="text-xs text-strata-subtle line-clamp-1 mt-0.5 mb-0">{{ category.description|striptags|trim }}</p>
                            {% endif %}
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="px-2.5 py-3 text-xs text-strata-subtle">
                {{ 'Browse all available services and plans in our catalog.'|trans }}
            </div>
        {% endif %}

        <div class="pt-1.5 mt-1 border-t border-strata-hairline">
            <a href="{{ 'order'|url }}"
               class="flex items-center justify-between px-2.5 py-2 rounded-lg text-xs font-semibold text-strata-brand hover:bg-strata-brand/10 transition-colors"
               role="menuitem">
                <span>{{ 'View all products & plans'|trans }}</span>
                <svg class="size-3.5" aria-hidden="true"><use href="#arrow-right" /></svg>
            </a>
        </div>
    </div>
</details>
